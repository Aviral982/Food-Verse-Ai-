# ==========================================
# FoodVerse AI — Environment Variables
# ==========================================

# 1. Backend AI & Cloud Credentials
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# Groq Multimodal Models
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_AUDIO_MODEL=whisper-large-v3

# Backend Server Configuration
ENVIRONMENT=development
PORT=8000
MAX_UPLOAD_SIZE_MB=25

# 2. Frontend Configuration
# URL of the deployed or local FastAPI backend
VITE_API_BASE_URL=http://localhost:8000

